ID_TGIRR_SBS     [_Button("SBS - Chon Polyline kin lam vung bao, chon mot doi tuong mau; cac...", "SBS.bmp", "SBS_L.bmp")]^C^CSBS
ID_TGIRR_SBSE    [_Button("SBSE - Chon Polyline kin lam vung bao roi chon mot doi tuong mau", "SBSE.bmp", "SBSE_L.bmp")]^C^CSBSE
ID_TGIRR_SCH     [_Button("SCH - Chon mot Hatch lam mau, roi quet vung can loc; nhan Enter de...", "SCH.bmp", "SCH_L.bmp")]^C^CSCH
ID_TGIRR_VDNG    [_Button("VDNG - Chon Boundary kin (LWPOLYLINE/CIRCLE), dat khoang cach day...", "VDNG.bmp", "VDNG_L.bmp")]^C^CVDNG
ID_TGIRR_TNET    [_Button("TNET - Nhap ten, doan gach, khoang trong, noi dung chu va ty le...", "TNET.bmp", "TNET_L.bmp")]^C^CTNET
ID_TGIRR_TGL     [_Button("TGL - Bam nut: lenh tu tao cac layer con thieu va giu nguyen layer...", "TGL.bmp", "TGL_L.bmp")]^C^CTGL
ID_TGIRR_TGLADD  [_Button("TGLADD - Nhap ten Layer, mau ACI va kieu net", "TGLADD.bmp", "TGLADD_L.bmp")]^C^CTGLADD
ID_TGIRR_TL      [_Button("TL - Chon truoc toan bo doi tuong roi bam nut, hoac bam nut roi...", "TL.bmp", "TL_L.bmp")]^C^CTL
ID_TGIRR_TGN     [_Button("TGN - Chon pham vi, so bat dau, buoc nhay, kich thuoc khung va...", "TGN.bmp", "TGN_L.bmp")]^C^CTGN
ID_TGIRR_CPLUS   [_Button("CPLUS - Chon noi dung can tang trong UI roi bam lien tiep cac diem dat", "CPLUS.bmp", "CPLUS_L.bmp")]^C^CCPLUS
ID_TGIRR_DOITEXT [_Button("DOITEXT - Chon cac MText can chuyen, chon che do List (gom danh sach)...", "DOITEXT.bmp", "DOITEXT_L.bmp")]^C^CDOITEXT
ID_TGIRR_DOIMTEXT [_Button("DOIMTEXT - Chon cac TEXT can gop, pick diem chen MTEXT (Enter de lay...", "DOIMTEXT.bmp", "DOIMTEXT_L.bmp")]^C^CDOIMTEXT
ID_TGIRR_KHO     [_Button("KHO - Chay trong Layout, chon kho giay (mac dinh A3)", "KHO.bmp", "KHO_L.bmp")]^C^CKHO
ID_TGIRR_TENBV   [_Button("TENBV - Chon T de ap dung moi layout hoac L cho layout hien tai, roi...", "TENBV.bmp", "TENBV_L.bmp")]^C^CTENBV

