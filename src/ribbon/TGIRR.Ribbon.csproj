<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tgirrr.CadLisp</RootNamespace>
    <AssemblyName>TGIRR.Ribbon</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Configuration for AutoCAD 2021-2024 (.NET Framework 4.8) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AutoCADDir Condition="'$(AutoCADDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2024\')">C:\Program Files\Autodesk\AutoCAD 2024\</AutoCADDir>
    <AutoCADDir Condition="'$(AutoCADDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2023\')">C:\Program Files\Autodesk\AutoCAD 2023\</AutoCADDir>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">$(MSBuildThisFileDirectory)..\..\Reference\Cad2023\net48\</AutoCADDir>
  </PropertyGroup>

  <!-- Configuration for AutoCAD 2027 (.NET 10) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <AutoCADDir Condition="'$(AutoCADDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2027\')">C:\Program Files\Autodesk\AutoCAD 2027\</AutoCADDir>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">$(MSBuildThisFileDirectory)..\..\Reference\Cad2027\</AutoCADDir>
  </PropertyGroup>

  <!-- Configuration for AutoCAD 2025-2026 (.NET 8) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <AutoCADDir Condition="'$(AutoCADDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2026\')">C:\Program Files\Autodesk\AutoCAD 2026\</AutoCADDir>
    <AutoCADDir Condition="'$(AutoCADDir)' == '' and Exists('C:\Program Files\Autodesk\AutoCAD 2025\')">C:\Program Files\Autodesk\AutoCAD 2025\</AutoCADDir>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">$(MSBuildThisFileDirectory)..\..\Reference\Cad2026\net8.0\</AutoCADDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Danh muc lenh sinh tu src/catalog/tools.json (scripts/gen-catalog.ps1).
         Namespace cua no la Tgirrr.CadLisp nen Ribbon dung chung metadata tooltip/nut. -->
    <Compile Include="..\shared\ToolCatalog.generated.cs" Link="ToolCatalog.generated.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADDir)accoremgd.dll</HintPath>
      <HintPath Condition="!Exists('$(AutoCADDir)accoremgd.dll')">$(AutoCADDir)AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADDir)acdbmgd.dll</HintPath>
      <HintPath Condition="!Exists('$(AutoCADDir)acdbmgd.dll')">$(AutoCADDir)AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADDir)acmgd.dll</HintPath>
      <HintPath Condition="!Exists('$(AutoCADDir)acmgd.dll')">$(AutoCADDir)AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AutoCADDir)AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
